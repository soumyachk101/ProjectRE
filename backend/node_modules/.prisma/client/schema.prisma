generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone       String   @unique @db.VarChar(20)
  name        String?  @db.VarChar(100)
  role        String   @default("user") @db.VarChar(20)
  vehicleType String?  @map("vehicle_type") @db.VarChar(30)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trips Trip[]

  @@index([phone])
  @@map("users")
}

model Trip {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  vehicleType    String?   @map("vehicle_type") @db.VarChar(30)
  phonePlacement String?   @map("phone_placement") @db.VarChar(30)
  status         String    @default("pending") @db.VarChar(20)
  rawDataPath    String?   @map("raw_data_path")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pocCandidates  PocCandidate[]
  roadEvents     RoadEvent[]
  sensorSessions SensorSession[]

  @@index([userId])
  @@index([status])
  @@map("trips")
}

/// PoC = Point of Concern — raw anomaly detection output before ML classification
model PocCandidate {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  lat           Float
  lng           Float
  zValue        Float     @map("z_value")
  zNext         Float?    @map("z_next")
  zPrev         Float?    @map("z_prev")
  tp            Float?
  speedKmh      Float?    @map("speed_kmh")
  thresholdUsed Float?    @map("threshold_used")
  recordedAt    DateTime? @map("recorded_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  trip       Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  roadEvents RoadEvent[]

  @@index([tripId])
  @@map("poc_candidates")
}

model RoadEvent {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tripId          String?  @map("trip_id") @db.Uuid
  pocCandidateId  String?  @map("poc_candidate_id") @db.Uuid
  eventType       String   @map("event_type") @db.VarChar(30)
  lat             Float
  lng             Float
  severity        String?  @db.VarChar(20)
  confidenceScore Float?   @map("confidence_score")
  isConfirmed     Boolean  @default(false) @map("is_confirmed")
  createdAt       DateTime @default(now()) @map("created_at")

  trip         Trip?                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pocCandidate PocCandidate?        @relation(fields: [pocCandidateId], references: [id], onDelete: SetNull)
  clusterLinks EventClusterMember[]

  @@index([tripId])
  @@index([eventType])
  @@map("road_events")
}

model ConfirmedEvent {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(30)
  lat             Float
  lng             Float
  trailCount      Int       @default(1) @map("trail_count")
  confidenceScore Float?    @map("confidence_score")
  firstSeen       DateTime? @map("first_seen")
  lastSeen        DateTime? @map("last_seen")
  isActive        Boolean   @default(true) @map("is_active")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  clusterMembers EventClusterMember[]

  @@index([eventType])
  @@index([isActive])
  @@map("confirmed_events")
}

model EventClusterMember {
  confirmedEventId String @map("confirmed_event_id") @db.Uuid
  roadEventId      String @map("road_event_id") @db.Uuid

  confirmedEvent ConfirmedEvent @relation(fields: [confirmedEventId], references: [id], onDelete: Cascade)
  roadEvent      RoadEvent      @relation(fields: [roadEventId], references: [id], onDelete: Cascade)

  @@id([confirmedEventId, roadEventId])
  @@map("event_cluster_members")
}

model SensorSession {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  filePath      String?  @map("file_path")
  fileSizeBytes BigInt?  @map("file_size_bytes")
  sampleCount   Int?     @map("sample_count")
  createdAt     DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("sensor_sessions")
}

model RoadQualityIndex {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lat1           Float
  lng1           Float
  lat2           Float
  lng2           Float
  rqiScore       Float     @map("rqi_score")
  segmentLengthM Float?    @map("segment_length_m")
  computedAt     DateTime? @map("computed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("road_quality_index")
}
